        vertical_amplitude_meters: 12.0,
        warp_amplitude_meters: 40.0,
        perceptual_roughness: 0.7,
        reflectance: 0.5,
    ),
    terrain_base_color: (0.42, 0.38, 0.34, 1.0),
    terrain_valley_color: (0.18, 0.16, 0.14, 1.0),
    walkable: false,
    sky: SkyCalibration(
        orbital_period_seconds: 1441931.2, // 16.689018 dias * 86400
