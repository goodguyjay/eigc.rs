// Recorte de Ganimedes: latitude média (40 graus), perto do oval auroral e da borda da calota de
// geada, no hemisfério sub-joviano, a 58 graus de longitude do ponto sub-joviano (`sky.geometry`).
MoonProfile(
    moon_id: Ganymede,
    display_name: "Ganimedes",
    jupiter_angular_diameter_deg: 7.64, // 2 * atan(71492 km / 1070400 km)
    terrain: TerrainCalibration(
        seed: 307,
        base_frequency: 0.00025, // 1.0 / 4000.0
        // direção dos sulcos, ~15 graus de norte-sul: o sol da manhã e da tarde (leste e oeste)
        // os marca com sombra
        feature_direction: (0.26, 0.97),
        warp_amplitude_meters: 0.0, // sem uso em Ganimedes
        perceptual_roughness: 0.8,
        reflectance: 0.5,
    ),
    terrain_base_color: (0.55, 0.50, 0.44, 1.0), // terreno escuro antigo, TODO (jay): ajustar visualmente
    // gelo exposto: o material escuro escorrega das encostas, TODO (jay): ajustar visualmente
    terrain_steep_color: (0.80, 0.79, 0.77, 1.0),
    walkable: true,
    sky: SkyCalibration(
        orbital_period_seconds: 618153.4, // 7.154553 dias * 86400
        // Júpiter a ~24 graus de elevação, a oeste
        geometry: Site(
            latitude_deg: 40.0,
            longitude_deg: 58.0,
            start_orbit_fraction: 0.20, // chegada de manhã, sol a ~30 graus subindo
        ),
        jupiter_libration_lat_deg: 0.0, // eixo de rotação normal à órbita: sem libração em latitude
        jupiter_libration_lon_deg: 0.15, // 2 * excentricidade (0.0013), em graus
        jupiter_ang_radius: 0.06667158, // (7.64 * 0.5).to_radians()
        eclipse_soft_deg: 1.0,
        planet_shine_max: 0.0025, // 0.006 de Europa * (7.64 / 11.9)^2, razão dos ângulos sólidos
    ),
)
