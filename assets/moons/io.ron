MoonProfile(
    moon_id: Io,
    display_name: "Io",
    jupiter_angular_diameter_deg: 19.24, // 2 * atan(71492 km / 421800 km)
    terrain: TerrainCalibration(
        seed: 501,
        base_frequency: 0.00025, // 1.0 / 4000.0
        feature_direction: (1.0, 0.0), // sem uso em Io (não há lineae)
        warp_amplitude_meters: 0.0, // sem uso em Io
        perceptual_roughness: 0.85,
        reflectance: 0.4,
    ),
    terrain_base_color: (0.86, 0.78, 0.45, 1.0), // planície de enxofre, TODO (jay): ajustar visualmente
    terrain_steep_color: (0.62, 0.42, 0.22, 1.0), // encostas alaranjadas, TODO (jay): ajustar visualmente
    walkable: true,
    sky: SkyCalibration(
        orbital_period_seconds: 152853.5, // 1.769138 dias * 86400
        // direções provisórias: a calibração do eclipse de Io (toda órbita) fica para a fase do céu
        base_sun_dir: (-0.15, 0.35, -0.92),
        base_jupiter_dir: (0.35, 0.37, -0.86),
        jupiter_libration_lat_deg: 2.0,
        jupiter_libration_lon_deg: 2.0,
        jupiter_ang_radius: 0.16790067, // (19.24 * 0.5).to_radians()
        sun_elevation_deg: 25.0,
        eclipse_soft_deg: 1.0,
        planet_shine_max: 0.016, // 0.006 de Europa * (19.24 / 11.9)^2, razão dos ângulos sólidos
    ),
)
